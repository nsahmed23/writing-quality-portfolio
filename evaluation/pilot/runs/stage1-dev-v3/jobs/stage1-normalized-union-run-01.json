    {
      "artifact_type": "security_documentation",
      "author_profile": "second_language_professional",
      "author_type": "second_language_security_engineer",
      "case_id": "S005-006",
      "genre": "second_language",
      "offset_unit": "unicode_codepoint",
      "protected_regions": [],
      "schema_version": "1.0",
      "split": "dev",
      "text": "In our team, requests are rejected when the nonce is older than 90 seconds, although clocks may differ by up to 4 seconds. We log the key ID, never the token. I say “never the token” exactly because new operators remember this line."
    },
    {
      "artifact_type": "landing_page_copy",
      "author_profile": "brand_marketer",
