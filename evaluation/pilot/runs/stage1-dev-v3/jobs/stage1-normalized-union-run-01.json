      "text": "Our revolutionary workspace unlocks limitless productivity for ambitious teams. The free plan includes one project and 2 GB of storage."
    },
    {
      "artifact_type": "procedure",
      "author_profile": "reference_editor",
      "author_type": "laboratory_writer",
      "case_id": "S006-006",
      "genre": "technical",
      "offset_unit": "unicode_codepoint",
      "protected_regions": [],
      "schema_version": "1.0",
