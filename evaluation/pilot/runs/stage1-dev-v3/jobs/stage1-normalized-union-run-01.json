      "text": "The specimen is accepted only when the label, consent code, and collection time all match the manifest. Missing any one field requires quarantine."
    },
    {
      "artifact_type": "impact_update",
      "author_profile": "brand_marketer",
      "author_type": "communications_writer",
      "case_id": "WQ-S003-001",
      "genre": "marketing",
      "offset_unit": "unicode_codepoint",
      "protected_regions": [],
      "schema_version": "1.0",
      "split": "dev",
      "text": "We are committed to delivering exceptional solutions that create meaningful outcomes. On 6 August, the support team reduced median wait time from 19 minutes to 11 minutes."
